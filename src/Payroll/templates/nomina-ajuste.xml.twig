<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<NominaIndividualDeAjuste xmlns="dian:gov:co:facturaelectronica:NominaIndividualDeAjuste"
                          xmlns:ds="http://www.w3.org/2000/09/xmldsig#"
                          xmlns:ext="urn:oasis:names:specification:ubl:schema:xsd:CommonExtensionComponents-2"
                          xmlns:xades="http://uri.etsi.org/01903/v1.3.2#"
                          xmlns:xades141="http://uri.etsi.org/01903/v1.4.1#"
                          xmlns:xs="http://www.w3.org/2001/XMLSchema-instance"
                          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                          SchemaLocation=""
                          xsi:schemaLocation="dian:gov:co:facturaelectronica:NominaIndividualDeAjuste NominaIndividualDeAjusteElectronicaXSD.xsd">
    <ext:UBLExtensions>
        <ext:UBLExtension>
            <ext:ExtensionContent/>
        </ext:UBLExtension>
    </ext:UBLExtensions>
    <TipoNota>{{ doc.tipoNota }}</TipoNota>
    {% set predecesor %} NumeroPred="{{ doc.numeroPred }}" CUNEPred="{{ doc.cunePred }}" FechaGenPred="{{ doc.fechaGenPred ? doc.fechaGenPred|date('Y-m-d') }}"{% endset %}
    {% if doc.eliminacion %}
    <Eliminar>
        <EliminandoPredecesor{{ predecesor }}/>
        {% include '_encabezado.xml.twig' with {version: 'V1.0: Nota de Ajuste de Documento Soporte de Pago de Nómina Electrónica', full: false} %}
    </Eliminar>
    {% else %}
    <Reemplazar>
        <ReemplazandoPredecesor{{ predecesor }}/>
        {% include '_periodo.xml.twig' %}
        {% include '_encabezado.xml.twig' with {version: 'V1.0: Nota de Ajuste de Documento Soporte de Pago de Nómina Electrónica', full: true} %}
        {% include '_cuerpo.xml.twig' %}
    </Reemplazar>
    {% endif %}
</NominaIndividualDeAjuste>
