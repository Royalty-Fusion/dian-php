<?xml version="1.0" encoding="UTF-8"?>
<ApplicationResponse xmlns="urn:oasis:names:specification:ubl:schema:xsd:ApplicationResponse-2"
                     xmlns:cac="urn:oasis:names:specification:ubl:schema:xsd:CommonAggregateComponents-2"
                     xmlns:cbc="urn:oasis:names:specification:ubl:schema:xsd:CommonBasicComponents-2"
                     xmlns:ext="urn:oasis:names:specification:ubl:schema:xsd:CommonExtensionComponents-2"
                     xmlns:sts="dian:gov:co:facturaelectronica:Structures-2-1"
                     xmlns:xades="http://uri.etsi.org/01903/v1.3.2#"
                     xmlns:ds="http://www.w3.org/2000/09/xmldsig#">
    <ext:UBLExtensions>
        <ext:UBLExtension>
            <ext:ExtensionContent/>
        </ext:UBLExtension>
    </ext:UBLExtensions>
    <cbc:UBLVersionID>UBL 2.1</cbc:UBLVersionID>
    <cbc:CustomizationID>{{ doc.event ? doc.event.code : '030' }}</cbc:CustomizationID>
    <cbc:ProfileID>DIAN 2.1: Aplicación de Respuesta</cbc:ProfileID>
    <cbc:ProfileExecutionID>2</cbc:ProfileExecutionID>
    <cbc:ID>{{ doc.id }}</cbc:ID>
    <cbc:UUID schemeID="1" schemeName="CUDE-SHA384">{{ doc.cude }}</cbc:UUID>
    <cbc:IssueDate>{{ doc.issueDate|date('Y-m-d') }}</cbc:IssueDate>
    <cbc:IssueTime>{{ doc.issueDate|date('H:i:sP') }}</cbc:IssueTime>

    {% if doc.receiver %}
    <cac:SenderParty>
        <cac:PartyTaxScheme>
            <cbc:RegistrationName>{{ doc.receiver.razonSocial }}</cbc:RegistrationName>
            <cbc:CompanyID schemeAgencyID="195" schemeID="{{ doc.receiver.nitDv }}" schemeName="{{ doc.receiver.tipoDocumento }}">{{ doc.receiver.nit }}</cbc:CompanyID>
            <cbc:TaxLevelCode>{{ doc.receiver.responsabilidades }}</cbc:TaxLevelCode>
            <cac:TaxScheme><cbc:ID>01</cbc:ID><cbc:Name>IVA</cbc:Name></cac:TaxScheme>
        </cac:PartyTaxScheme>
    </cac:SenderParty>
    {% endif %}

    {% if doc.supplier %}
    <cac:ReceiverParty>
        <cac:PartyTaxScheme>
            <cbc:RegistrationName>{{ doc.supplier.razonSocial }}</cbc:RegistrationName>
            <cbc:CompanyID schemeAgencyID="195" schemeName="{{ doc.supplier.tipoDocumento }}">{{ doc.supplier.numeroDocumento }}</cbc:CompanyID>
            <cbc:TaxLevelCode>{{ doc.supplier.responsabilidades }}</cbc:TaxLevelCode>
            <cac:TaxScheme><cbc:ID>01</cbc:ID><cbc:Name>IVA</cbc:Name></cac:TaxScheme>
        </cac:PartyTaxScheme>
    </cac:ReceiverParty>
    {% endif %}

    <cac:DocumentResponse>
        <cac:Response>
            <cbc:ResponseCode>{{ doc.event ? doc.event.code : '030' }}</cbc:ResponseCode>
            {% if doc.event and doc.event.description %}<cbc:Description>{{ doc.event.description }}</cbc:Description>{% endif %}
        </cac:Response>
        <cac:DocumentReference>
            <cbc:ID>{{ doc.invoiceId }}</cbc:ID>
            <cbc:UUID schemeName="CUFE-SHA384">{{ doc.invoiceCufe }}</cbc:UUID>
            {% if doc.invoiceDate %}<cbc:IssueDate>{{ doc.invoiceDate|date('Y-m-d') }}</cbc:IssueDate>{% endif %}
            <cbc:DocumentTypeCode>01</cbc:DocumentTypeCode>
        </cac:DocumentReference>
        <cac:IssuerParty>
            {% if doc.supplier %}
            <cac:PartyTaxScheme>
                <cbc:RegistrationName>{{ doc.supplier.razonSocial }}</cbc:RegistrationName>
                <cbc:CompanyID schemeAgencyID="195" schemeName="{{ doc.supplier.tipoDocumento }}">{{ doc.supplier.numeroDocumento }}</cbc:CompanyID>
                <cac:TaxScheme><cbc:ID>01</cbc:ID><cbc:Name>IVA</cbc:Name></cac:TaxScheme>
            </cac:PartyTaxScheme>
            {% endif %}
        </cac:IssuerParty>
        <cac:RecipientParty>
            {% if doc.receiver %}
            <cac:PartyTaxScheme>
                <cbc:RegistrationName>{{ doc.receiver.razonSocial }}</cbc:RegistrationName>
                <cbc:CompanyID schemeAgencyID="195" schemeID="{{ doc.receiver.nitDv }}" schemeName="{{ doc.receiver.tipoDocumento }}">{{ doc.receiver.nit }}</cbc:CompanyID>
                <cac:TaxScheme><cbc:ID>01</cbc:ID><cbc:Name>IVA</cbc:Name></cac:TaxScheme>
            </cac:PartyTaxScheme>
            {% endif %}
        </cac:RecipientParty>
    </cac:DocumentResponse>
</ApplicationResponse>
