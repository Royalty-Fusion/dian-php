<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<ApplicationResponse xmlns="urn:oasis:names:specification:ubl:schema:xsd:ApplicationResponse-2"
                     xmlns:cac="urn:oasis:names:specification:ubl:schema:xsd:CommonAggregateComponents-2"
                     xmlns:cbc="urn:oasis:names:specification:ubl:schema:xsd:CommonBasicComponents-2"
                     xmlns:ds="http://www.w3.org/2000/09/xmldsig#"
                     xmlns:ext="urn:oasis:names:specification:ubl:schema:xsd:CommonExtensionComponents-2"
                     xmlns:sts="dian:gov:co:facturaelectronica:Structures-2-1"
                     xmlns:xades="http://uri.etsi.org/01903/v1.3.2#"
                     xmlns:xades141="http://uri.etsi.org/01903/v1.4.1#">
    <ext:UBLExtensions>
        <ext:UBLExtension>
            <ext:ExtensionContent>
                <sts:DianExtensions>
                    <sts:InvoiceSource>
                        <cbc:IdentificationCode listAgencyID="6" listAgencyName="United Nations Economic Commission for Europe" listSchemeURI="urn:oasis:names:specification:ubl:codelist:gc:CountryIdentificationCode-2.1">CO</cbc:IdentificationCode>
                    </sts:InvoiceSource>
                    <sts:SoftwareProvider>
                        <sts:ProviderID schemeAgencyID="195" schemeAgencyName="CO, DIAN (Dirección de Impuestos y Aduanas Nacionales)" schemeID="{{ providerDv }}" schemeName="31">{{ providerNit }}</sts:ProviderID>
                        <sts:SoftwareID schemeAgencyID="195" schemeAgencyName="CO, DIAN (Dirección de Impuestos y Aduanas Nacionales)">{{ doc.software ? doc.software.id }}</sts:SoftwareID>
                    </sts:SoftwareProvider>
                    <sts:SoftwareSecurityCode schemeAgencyID="195" schemeAgencyName="CO, DIAN (Dirección de Impuestos y Aduanas Nacionales)">{{ doc.software ? doc.software.getSecurityCode(doc.id) }}</sts:SoftwareSecurityCode>
                    <sts:AuthorizationProvider>
                        <sts:AuthorizationProviderID schemeAgencyID="195" schemeAgencyName="CO, DIAN (Dirección de Impuestos y Aduanas Nacionales)" schemeID="4" schemeName="31">800197268</sts:AuthorizationProviderID>
                    </sts:AuthorizationProvider>
                    <sts:QRCode>{{ qrCode }}</sts:QRCode>
                </sts:DianExtensions>
            </ext:ExtensionContent>
        </ext:UBLExtension>
        <ext:UBLExtension>
            <ext:ExtensionContent/>
        </ext:UBLExtension>
    </ext:UBLExtensions>
    <cbc:UBLVersionID>UBL 2.1</cbc:UBLVersionID>
    <cbc:CustomizationID>1</cbc:CustomizationID>
    <cbc:ProfileID>DIAN 2.1: ApplicationResponse de la Factura Electrónica de Venta</cbc:ProfileID>
    <cbc:ProfileExecutionID>{{ environment }}</cbc:ProfileExecutionID>
    <cbc:ID>{{ doc.id }}</cbc:ID>
    <cbc:UUID schemeID="{{ environment }}" schemeName="CUDE-SHA384">{{ doc.cude }}</cbc:UUID>
    <cbc:IssueDate>{{ issueDate }}</cbc:IssueDate>
    <cbc:IssueTime>{{ issueTime }}</cbc:IssueTime>
    {% if doc.receiver %}
    <cac:SenderParty>
        <cac:PartyTaxScheme>
            <cbc:RegistrationName>{{ doc.receiver.razonSocial }}</cbc:RegistrationName>
            <cbc:CompanyID schemeAgencyID="195" schemeAgencyName="CO, DIAN (Dirección de Impuestos y Aduanas Nacionales)" schemeID="{{ doc.receiver.nitDv }}" schemeName="{{ doc.receiver.tipoDocumento ?: '31' }}">{{ doc.receiver.nit }}</cbc:CompanyID>
            <cbc:TaxLevelCode>{{ doc.receiver.responsabilidades ?: 'R-99-PN' }}</cbc:TaxLevelCode>
            <cac:TaxScheme><cbc:ID>{{ doc.receiver.taxSchemeId }}</cbc:ID><cbc:Name>{{ doc.receiver.taxSchemeName }}</cbc:Name></cac:TaxScheme>
        </cac:PartyTaxScheme>
    </cac:SenderParty>
    {% endif %}
    {% if doc.supplier %}
    <cac:ReceiverParty>
        <cac:PartyTaxScheme>
            <cbc:RegistrationName>{{ doc.supplier.razonSocial }}</cbc:RegistrationName>
            <cbc:CompanyID schemeAgencyID="195" schemeAgencyName="CO, DIAN (Dirección de Impuestos y Aduanas Nacionales)"{% if doc.supplier.nitDv is not null %} schemeID="{{ doc.supplier.nitDv }}"{% endif %} schemeName="{{ doc.supplier.tipoDocumento }}">{{ doc.supplier.numeroDocumento }}</cbc:CompanyID>
            <cbc:TaxLevelCode>{{ doc.supplier.responsabilidades ?: 'R-99-PN' }}</cbc:TaxLevelCode>
            <cac:TaxScheme><cbc:ID>{{ doc.supplier.taxSchemeId }}</cbc:ID><cbc:Name>{{ doc.supplier.taxSchemeName }}</cbc:Name></cac:TaxScheme>
        </cac:PartyTaxScheme>
    </cac:ReceiverParty>
    {% endif %}
    <cac:DocumentResponse>
        <cac:Response>
            <cbc:ResponseCode>{{ doc.event ? doc.event.code : '030' }}</cbc:ResponseCode>
            {% if doc.event and doc.event.description %}<cbc:Description>{{ doc.event.description }}</cbc:Description>{% endif %}
        </cac:Response>
        <cac:DocumentReference>
            <cbc:ID>{{ doc.invoiceId }}</cbc:ID>
            <cbc:UUID schemeName="CUFE-SHA384">{{ doc.invoiceCufe }}</cbc:UUID>
            {% if doc.invoiceDate %}<cbc:IssueDate>{{ doc.invoiceDate|date('Y-m-d') }}</cbc:IssueDate>{% endif %}
            <cbc:DocumentTypeCode>{{ doc.documentTypeCode }}</cbc:DocumentTypeCode>
        </cac:DocumentReference>
        {% if doc.person %}
        <cac:IssuerParty>
            <cac:Person>
                <cbc:ID schemeID="{{ doc.person.dv }}" schemeName="{{ doc.person.idType }}">{{ doc.person.id }}</cbc:ID>
                <cbc:FirstName>{{ doc.person.firstName }}</cbc:FirstName>
                <cbc:FamilyName>{{ doc.person.familyName }}</cbc:FamilyName>
                {% if doc.person.jobTitle %}<cbc:JobTitle>{{ doc.person.jobTitle }}</cbc:JobTitle>{% endif %}
                {% if doc.person.department %}<cbc:OrganizationDepartment>{{ doc.person.department }}</cbc:OrganizationDepartment>{% endif %}
            </cac:Person>
        </cac:IssuerParty>
        {% endif %}
    </cac:DocumentResponse>
</ApplicationResponse>
