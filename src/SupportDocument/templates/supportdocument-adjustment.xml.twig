<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<CreditNote xmlns="urn:oasis:names:specification:ubl:schema:xsd:CreditNote-2"
            xmlns:cac="urn:oasis:names:specification:ubl:schema:xsd:CommonAggregateComponents-2"
            xmlns:cbc="urn:oasis:names:specification:ubl:schema:xsd:CommonBasicComponents-2"
            xmlns:ds="http://www.w3.org/2000/09/xmldsig#"
            xmlns:ext="urn:oasis:names:specification:ubl:schema:xsd:CommonExtensionComponents-2"
            xmlns:sts="dian:gov:co:facturaelectronica:Structures-2-1"
            xmlns:xades="http://uri.etsi.org/01903/v1.3.2#"
            xmlns:xades141="http://uri.etsi.org/01903/v1.4.1#">
    {% include '@dian/dian_extensions.xml.twig' with {withControl: false} %}
    {% include '@dian/document_header.xml.twig' with {schemeName: 'CUDS-SHA384', profileId: 'DIAN 2.1: Nota de ajuste al documento soporte en adquisiciones efectuadas a sujetos no obligados a expedir factura.'} %}
    <cbc:CreditNoteTypeCode>95</cbc:CreditNoteTypeCode>
    {% for note in doc.notes %}
    <cbc:Note>{{ note.text }}</cbc:Note>
    {% endfor %}
    <cbc:DocumentCurrencyCode>{{ currency }}</cbc:DocumentCurrencyCode>
    <cbc:LineCountNumeric>{{ doc.items|length }}</cbc:LineCountNumeric>
    {% if doc.discrepancyResponse %}
    <cac:DiscrepancyResponse>
        <cbc:ReferenceID>{{ doc.discrepancyResponse.referenceId ?: (doc.billingReference ? doc.billingReference.number) }}</cbc:ReferenceID>
        <cbc:ResponseCode>{{ doc.discrepancyResponse.responseCode }}</cbc:ResponseCode>
        <cbc:Description>{{ doc.discrepancyResponse.description }}</cbc:Description>
    </cac:DiscrepancyResponse>
    {% endif %}
    {% if doc.billingReference %}
    <cac:BillingReference>
        <cac:InvoiceDocumentReference>
            <cbc:ID>{{ doc.billingReference.number }}</cbc:ID>
            <cbc:UUID schemeName="CUDS-SHA384">{{ doc.billingReference.uuid }}</cbc:UUID>
            <cbc:IssueDate>{{ doc.billingReference.date|date('Y-m-d') }}</cbc:IssueDate>
        </cac:InvoiceDocumentReference>
    </cac:BillingReference>
    {% endif %}
    {% if doc.supplier %}{% include '@dian/client_party.xml.twig' with {c: doc.supplier, tag: 'cac:AccountingSupplierParty'} only %}{% endif %}
    {% if doc.company %}{% include '@dian/company_party.xml.twig' with {c: doc.company, tag: 'cac:AccountingCustomerParty', corporatePrefix: null} only %}{% endif %}
    {% include '@dian/payment_means.xml.twig' %}
    {% if doc.paymentExchangeRate %}{% include '@dian/exchange_rate.xml.twig' with {rate: doc.paymentExchangeRate} %}{% endif %}
    {% for ac in doc.allowanceCharges %}
    {% include '@dian/allowance_charge.xml.twig' with {ac: ac} %}
    {% endfor %}
    {% include '@dian/tax_totals.xml.twig' with {groups: totals.taxGroups, tag: 'TaxTotal'} %}
    {% include '@dian/monetary_total.xml.twig' with {tag: 'LegalMonetaryTotal', withPrepaid: false} %}
    {% include '@dian/lines.xml.twig' with {lineTag: 'CreditNoteLine', qtyTag: 'CreditedQuantity', chargesFirst: false} %}
</CreditNote>
