<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<Invoice xmlns="urn:oasis:names:specification:ubl:schema:xsd:Invoice-2"
         xmlns:cac="urn:oasis:names:specification:ubl:schema:xsd:CommonAggregateComponents-2"
         xmlns:cbc="urn:oasis:names:specification:ubl:schema:xsd:CommonBasicComponents-2"
         xmlns:ds="http://www.w3.org/2000/09/xmldsig#"
         xmlns:ext="urn:oasis:names:specification:ubl:schema:xsd:CommonExtensionComponents-2"
         xmlns:sts="dian:gov:co:facturaelectronica:Structures-2-1"
         xmlns:xades="http://uri.etsi.org/01903/v1.3.2#"
         xmlns:xades141="http://uri.etsi.org/01903/v1.4.1#">
    {% include '@dian/dian_extensions.xml.twig' with {withControl: true} %}
    {% include '@dian/document_header.xml.twig' with {schemeName: 'CUFE-SHA384', profileId: 'DIAN 2.1: Factura Electrónica de Venta'} %}
    {% if doc.dueDate %}<cbc:DueDate>{{ doc.dueDate|date('Y-m-d') }}</cbc:DueDate>{% endif %}
    <cbc:InvoiceTypeCode>{{ doc.invoiceTypeCode }}</cbc:InvoiceTypeCode>
    {% for note in doc.notes %}
    <cbc:Note>{{ note.text }}</cbc:Note>
    {% endfor %}
    <cbc:DocumentCurrencyCode>{{ currency }}</cbc:DocumentCurrencyCode>
    <cbc:LineCountNumeric>{{ doc.items|length }}</cbc:LineCountNumeric>
    {% if doc.invoicePeriodStart %}
    <cac:InvoicePeriod>
        <cbc:StartDate>{{ doc.invoicePeriodStart|date('Y-m-d') }}</cbc:StartDate>
        <cbc:EndDate>{{ doc.invoicePeriodEnd|date('Y-m-d') }}</cbc:EndDate>
    </cac:InvoicePeriod>
    {% endif %}
    {% for ref in doc.additionalDocumentReferences|filter(r => r.type == 'OrderReference') %}
    <cac:OrderReference>
        <cbc:ID>{{ ref.id }}</cbc:ID>
        {% if ref.issueDate %}<cbc:IssueDate>{{ ref.issueDate|date('Y-m-d') }}</cbc:IssueDate>{% endif %}
    </cac:OrderReference>
    {% endfor %}
    {% for ref in doc.additionalDocumentReferences|filter(r => r.type == 'AdditionalDocumentReference') %}
    <cac:AdditionalDocumentReference>
        <cbc:ID>{{ ref.id }}</cbc:ID>
        {% if ref.issueDate %}<cbc:IssueDate>{{ ref.issueDate|date('Y-m-d') }}</cbc:IssueDate>{% endif %}
        {% if ref.documentTypeCode is defined and ref.documentTypeCode %}<cbc:DocumentTypeCode>{{ ref.documentTypeCode }}</cbc:DocumentTypeCode>{% endif %}
        {% if ref.documentType %}<cbc:DocumentType>{{ ref.documentType }}</cbc:DocumentType>{% endif %}
    </cac:AdditionalDocumentReference>
    {% endfor %}
    {% if doc.company %}{% include '@dian/company_party.xml.twig' with {c: doc.company, tag: 'cac:AccountingSupplierParty', corporatePrefix: doc.prefijo} only %}{% endif %}
    {% if doc.client %}{% include '@dian/client_party.xml.twig' with {c: doc.client, tag: 'cac:AccountingCustomerParty'} only %}{% endif %}
    {% include '@dian/payment_means.xml.twig' %}
    {% for prepayment in doc.prepayments %}
    <cac:PrepaidPayment>
        <cbc:ID>{{ prepayment.id }}</cbc:ID>
        <cbc:PaidAmount currencyID="{{ currency }}">{{ prepayment.paidAmount|money }}</cbc:PaidAmount>
        {% if prepayment.paidDate %}<cbc:PaidDate>{{ prepayment.paidDate|date('Y-m-d') }}</cbc:PaidDate>{% endif %}
    </cac:PrepaidPayment>
    {% endfor %}
    {% for ac in doc.allowanceCharges %}
    {% include '@dian/allowance_charge.xml.twig' with {ac: ac} %}
    {% endfor %}
    {% if doc.paymentExchangeRate %}{% include '@dian/exchange_rate.xml.twig' with {rate: doc.paymentExchangeRate} %}{% endif %}
    {% include '@dian/tax_totals.xml.twig' with {groups: totals.taxGroups, tag: 'TaxTotal'} %}
    {% include '@dian/tax_totals.xml.twig' with {groups: totals.withholdingTaxGroups, tag: 'WithholdingTaxTotal'} %}
    {% include '@dian/monetary_total.xml.twig' with {tag: 'LegalMonetaryTotal', withPrepaid: true} %}
    {% include '@dian/lines.xml.twig' with {lineTag: 'InvoiceLine', qtyTag: 'InvoicedQuantity', chargesFirst: true} %}
</Invoice>
