<?xml version="1.0" encoding="UTF-8"?>
<CreditNote xmlns="urn:oasis:names:specification:ubl:schema:xsd:CreditNote-2"
            xmlns:cac="urn:oasis:names:specification:ubl:schema:xsd:CommonAggregateComponents-2"
            xmlns:cbc="urn:oasis:names:specification:ubl:schema:xsd:CommonBasicComponents-2"
            xmlns:ext="urn:oasis:names:specification:ubl:schema:xsd:CommonExtensionComponents-2"
            xmlns:sts="dian:gov:co:facturaelectronica:Structures-2-1"
            xmlns:xades="http://uri.etsi.org/01903/v1.3.2#"
            xmlns:xades141="http://uri.etsi.org/01903/v1.4.1#"
            xmlns:ds="http://www.w3.org/2000/09/xmldsig#">
    <ext:UBLExtensions>
        <ext:UBLExtension>
            <ext:ExtensionContent>
                <sts:DianExtensions>
                    <sts:InvoiceSource>
                        <cbc:IdentificationCode listAgencyID="6" listAgencyName="United Nations Economic Commission for Europe" listSchemeURI="urn:oasis:names:specification:ubl:codelist:gc:CountryIdentificationCode-2.0">CO</cbc:IdentificationCode>
                    </sts:InvoiceSource>
                    {% if doc.software %}
                    <sts:SoftwareProvider>
                        <sts:ProviderID schemeAgencyID="195" schemeAgencyName="CO, DIAN (Dirección de Impuestos y Aduanas Nacionales)" schemeID="{{ doc.company ? doc.company.nitDv : 0 }}">{{ doc.software.providerNit }}</sts:ProviderID>
                        <sts:SoftwareID schemeAgencyID="195" schemeAgencyName="CO, DIAN (Dirección de Impuestos y Aduanas Nacionales)">{{ doc.software.id }}</sts:SoftwareID>
                    </sts:SoftwareProvider>
                    <sts:SoftwareSecurityCode schemeAgencyID="195" schemeAgencyName="CO, DIAN (Dirección de Impuestos y Aduanas Nacionales)">{{ doc.software.getSecurityCode(doc.prefijo ~ doc.numero) }}</sts:SoftwareSecurityCode>
                    {% endif %}
                    <sts:AuthorizationProvider>
                        <sts:AuthorizationProviderID schemeAgencyID="195" schemeAgencyName="CO, DIAN (Dirección de Impuestos y Aduanas Nacionales)" schemeID="4">800197268</sts:AuthorizationProviderID>
                    </sts:AuthorizationProvider>
                    <sts:QRCode>{{ qrCodeUrl }}</sts:QRCode>
                </sts:DianExtensions>
            </ext:ExtensionContent>
        </ext:UBLExtension>
        <ext:UBLExtension>
            <ext:ExtensionContent/>
        </ext:UBLExtension>
    </ext:UBLExtensions>
    <cbc:UBLVersionID>UBL 2.1</cbc:UBLVersionID>
    <cbc:CustomizationID>{% if doc.billingReference %}20{% else %}22{% endif %}</cbc:CustomizationID>
    <cbc:ProfileID>DIAN 2.1: Nota Crédito de Factura Electrónica de Venta</cbc:ProfileID>
    <cbc:ProfileExecutionID>{{ profileExecId }}</cbc:ProfileExecutionID>
    <cbc:ID>{{ doc.prefijo }}{{ doc.numero }}</cbc:ID>
    <cbc:UUID schemeID="{{ uuidSchemeId }}" schemeName="CUDE-SHA384">{{ cude }}</cbc:UUID>
    <cbc:IssueDate>{{ doc.fecha|date('Y-m-d') }}</cbc:IssueDate>
    <cbc:IssueTime>{{ doc.fecha|date('H:i:sP') }}</cbc:IssueTime>
    <cbc:CreditNoteTypeCode listAgencyID="195" listAgencyName="CO, DIAN (Dirección de Impuestos y Aduanas Nacionales)" listSchemeURI="urn:oasis:names:specification:ubl:codelist:gc:CreditNoteTypeCode-2.1">91</cbc:CreditNoteTypeCode>
    {% for note in doc.notes %}
    <cbc:Note>{{ note.text }}</cbc:Note>
    {% endfor %}
    <cbc:DocumentCurrencyCode listAgencyID="6" listAgencyName="United Nations Economic Commission for Europe" listSchemeURI="urn:oasis:names:specification:ubl:codelist:gc:CurrencyCode-2.0">{{ doc.currencyCode }}</cbc:DocumentCurrencyCode>
    <cbc:LineCountNumeric>{{ doc.items|length }}</cbc:LineCountNumeric>

    {% if doc.discrepancyResponse %}
    <cac:DiscrepancyResponse>
        <cbc:ReferenceID>{{ doc.discrepancyResponse.referenceId }}</cbc:ReferenceID>
        <cbc:ResponseCode>{{ doc.discrepancyResponse.responseCode }}</cbc:ResponseCode>
        <cbc:Description>{{ doc.discrepancyResponse.description }}</cbc:Description>
    </cac:DiscrepancyResponse>
    {% endif %}

    {% if doc.billingReference %}
    <cac:BillingReference>
        <cac:InvoiceDocumentReference>
            <cbc:ID>{{ doc.billingReference.number }}</cbc:ID>
            <cbc:UUID schemeName="CUFE-SHA384">{{ doc.billingReference.uuid }}</cbc:UUID>
            <cbc:IssueDate>{{ doc.billingReference.date|date('Y-m-d') }}</cbc:IssueDate>
        </cac:InvoiceDocumentReference>
    </cac:BillingReference>
    {% endif %}

    {% if doc.company %}
    <cac:AccountingSupplierParty>
        <cbc:AdditionalAccountID>{{ doc.company.tipoOrganizacion }}</cbc:AdditionalAccountID>
        <cac:Party>
            <cac:PartyIdentification>
                <cbc:ID schemeAgencyID="195" schemeAgencyName="CO, DIAN (Dirección de Impuestos y Aduanas Nacionales)" schemeName="{{ doc.company.tipoDocumento }}">{{ doc.company.nit }}</cbc:ID>
            </cac:PartyIdentification>
            <cac:PartyName>
                <cbc:Name>{{ doc.company.commercialName }}</cbc:Name>
            </cac:PartyName>
            {% if doc.company.address %}
            <cac:PhysicalLocation>
                <cac:Address>
                    <cbc:ID>{{ doc.company.address.cityCode }}</cbc:ID>
                    <cbc:CityName>{{ doc.company.address.cityName }}</cbc:CityName>
                    <cbc:CountrySubentity>{{ doc.company.address.departmentName }}</cbc:CountrySubentity>
                    <cbc:CountrySubentityCode>{{ doc.company.address.departmentCode }}</cbc:CountrySubentityCode>
                    <cac:AddressLine>
                        <cbc:Line>{{ doc.company.address.line }}</cbc:Line>
                    </cac:AddressLine>
                    <cac:Country>
                        <cbc:IdentificationCode>{{ doc.company.address.countryCode }}</cbc:IdentificationCode>
                        <cbc:Name languageID="es">{{ doc.company.address.countryName }}</cbc:Name>
                    </cac:Country>
                </cac:Address>
            </cac:PhysicalLocation>
            {% endif %}
            <cac:PartyTaxScheme>
                <cbc:RegistrationName>{{ doc.company.razonSocial }}</cbc:RegistrationName>
                <cbc:CompanyID schemeAgencyID="195" schemeAgencyName="CO, DIAN (Dirección de Impuestos y Aduanas Nacionales)" schemeID="{{ doc.company.nitDv }}" schemeName="{{ doc.company.tipoDocumento }}">{{ doc.company.nit }}</cbc:CompanyID>
                <cbc:TaxLevelCode listName="{{ doc.company.taxLevelCode ?: doc.company.regimen }}">{{ doc.company.responsabilidades }}</cbc:TaxLevelCode>
                <cac:TaxScheme>
                    <cbc:ID>01</cbc:ID>
                    <cbc:Name>IVA</cbc:Name>
                </cac:TaxScheme>
            </cac:PartyTaxScheme>
            <cac:PartyLegalEntity>
                <cbc:RegistrationName>{{ doc.company.razonSocial }}</cbc:RegistrationName>
                <cbc:CompanyID schemeAgencyID="195" schemeAgencyName="CO, DIAN (Dirección de Impuestos y Aduanas Nacionales)" schemeID="{{ doc.company.nitDv }}" schemeName="{{ doc.company.tipoDocumento }}">{{ doc.company.nit }}</cbc:CompanyID>
                <cac:CorporateRegistrationScheme>
                    <cbc:ID>{{ doc.company.industryClassificationCode }}</cbc:ID>
                    <cbc:Name>{{ doc.company.responsabilidades }}</cbc:Name>
                </cac:CorporateRegistrationScheme>
            </cac:PartyLegalEntity>
            {% if doc.company.contact %}
            <cac:Contact>
                {% if doc.company.contact.name %}<cbc:Name>{{ doc.company.contact.name }}</cbc:Name>{% endif %}
                {% if doc.company.contact.telephone %}<cbc:Telephone>{{ doc.company.contact.telephone }}</cbc:Telephone>{% endif %}
                {% if doc.company.contact.electronicMail %}<cbc:ElectronicMail>{{ doc.company.contact.electronicMail }}</cbc:ElectronicMail>{% endif %}
            </cac:Contact>
            {% endif %}
        </cac:Party>
    </cac:AccountingSupplierParty>
    {% endif %}

    {% if doc.client %}
    <cac:AccountingCustomerParty>
        <cbc:AdditionalAccountID>{{ doc.client.tipoOrganizacion }}</cbc:AdditionalAccountID>
        <cac:Party>
            <cac:PartyIdentification>
                <cbc:ID schemeAgencyID="195" schemeAgencyName="CO, DIAN (Dirección de Impuestos y Aduanas Nacionales)" schemeName="{{ doc.client.tipoDocumento }}">{{ doc.client.numeroDocumento }}</cbc:ID>
            </cac:PartyIdentification>
            <cac:PartyName>
                <cbc:Name>{{ doc.client.razonSocial }}</cbc:Name>
            </cac:PartyName>
            {% if doc.client.address %}
            <cac:PhysicalLocation>
                <cac:Address>
                    <cbc:ID>{{ doc.client.address.cityCode }}</cbc:ID>
                    <cbc:CityName>{{ doc.client.address.cityName }}</cbc:CityName>
                    <cbc:CountrySubentity>{{ doc.client.address.departmentName }}</cbc:CountrySubentity>
                    <cbc:CountrySubentityCode>{{ doc.client.address.departmentCode }}</cbc:CountrySubentityCode>
                    <cac:AddressLine>
                        <cbc:Line>{{ doc.client.address.line }}</cbc:Line>
                    </cac:AddressLine>
                    <cac:Country>
                        <cbc:IdentificationCode>{{ doc.client.address.countryCode }}</cbc:IdentificationCode>
                        <cbc:Name languageID="es">{{ doc.client.address.countryName }}</cbc:Name>
                    </cac:Country>
                </cac:Address>
            </cac:PhysicalLocation>
            {% endif %}
            <cac:PartyTaxScheme>
                <cbc:RegistrationName>{{ doc.client.razonSocial }}</cbc:RegistrationName>
                <cbc:CompanyID schemeAgencyID="195" schemeAgencyName="CO, DIAN (Dirección de Impuestos y Aduanas Nacionales)" schemeName="{{ doc.client.tipoDocumento }}">{{ doc.client.numeroDocumento }}</cbc:CompanyID>
                <cbc:TaxLevelCode listName="{{ doc.client.taxLevelCode ?: doc.client.regimen }}">{{ doc.client.responsabilidades }}</cbc:TaxLevelCode>
                <cac:TaxScheme>
                    <cbc:ID>{% if doc.client.responsabilidades == 'R-99-PN' %}ZZ{% else %}01{% endif %}</cbc:ID>
                    <cbc:Name>{% if doc.client.responsabilidades == 'R-99-PN' %}No aplica{% else %}IVA{% endif %}</cbc:Name>
                </cac:TaxScheme>
            </cac:PartyTaxScheme>
            <cac:PartyLegalEntity>
                <cbc:RegistrationName>{{ doc.client.razonSocial }}</cbc:RegistrationName>
                <cbc:CompanyID schemeAgencyID="195" schemeAgencyName="CO, DIAN (Dirección de Impuestos y Aduanas Nacionales)" schemeName="{{ doc.client.tipoDocumento }}">{{ doc.client.numeroDocumento }}</cbc:CompanyID>
            </cac:PartyLegalEntity>
            {% if doc.client.contact or doc.client.email %}
            <cac:Contact>
                {% if doc.client.contact and doc.client.contact.name %}<cbc:Name>{{ doc.client.contact.name }}</cbc:Name>{% endif %}
                {% if doc.client.contact and doc.client.contact.telephone %}<cbc:Telephone>{{ doc.client.contact.telephone }}</cbc:Telephone>{% endif %}
                {% set email = doc.client.contact ? doc.client.contact.electronicMail : doc.client.email %}
                {% if email %}<cbc:ElectronicMail>{{ email }}</cbc:ElectronicMail>{% endif %}
            </cac:Contact>
            {% endif %}
        </cac:Party>
    </cac:AccountingCustomerParty>
    {% endif %}

    {% for payment in doc.payments %}
    <cac:PaymentMeans>
        <cbc:ID>{{ payment.methodId }}</cbc:ID>
        <cbc:PaymentMeansCode>{{ payment.meansId }}</cbc:PaymentMeansCode>
        {% if payment.dueDate %}<cbc:PaymentDueDate>{{ payment.dueDate|date('Y-m-d') }}</cbc:PaymentDueDate>{% endif %}
    </cac:PaymentMeans>
    {% endfor %}

    {% if doc.paymentExchangeRate %}
    <cac:PaymentExchangeRate>
        <cbc:SourceCurrencyCode>{{ doc.paymentExchangeRate.sourceCurrencyCode }}</cbc:SourceCurrencyCode>
        <cbc:SourceCurrencyBaseRate>{{ doc.paymentExchangeRate.sourceCurrencyBaseRate|number_format(2, '.', '') }}</cbc:SourceCurrencyBaseRate>
        <cbc:TargetCurrencyCode>{{ doc.paymentExchangeRate.targetCurrencyCode }}</cbc:TargetCurrencyCode>
        <cbc:TargetCurrencyBaseRate>{{ doc.paymentExchangeRate.targetCurrencyBaseRate|number_format(2, '.', '') }}</cbc:TargetCurrencyBaseRate>
        <cbc:CalculationRate>{{ doc.paymentExchangeRate.calculationRate|number_format(2, '.', '') }}</cbc:CalculationRate>
        {% if doc.paymentExchangeRate.date %}<cbc:Date>{{ doc.paymentExchangeRate.date|date('Y-m-d') }}</cbc:Date>{% endif %}
    </cac:PaymentExchangeRate>
    {% endif %}

    {% for ac in doc.allowanceCharges %}
    <cac:AllowanceCharge>
        <cbc:ID>{{ ac.id }}</cbc:ID>
        <cbc:ChargeIndicator>{{ ac.isCharge ? 'true' : 'false' }}</cbc:ChargeIndicator>
        {% if ac.reasonCode %}<cbc:AllowanceChargeReasonCode>{{ ac.reasonCode }}</cbc:AllowanceChargeReasonCode>{% endif %}
        {% if ac.reason %}<cbc:AllowanceChargeReason>{{ ac.reason }}</cbc:AllowanceChargeReason>{% endif %}
        <cbc:Amount currencyID="{{ doc.currencyCode }}">{{ ac.amount|number_format(2, '.', '') }}</cbc:Amount>
        <cbc:BaseAmount currencyID="{{ doc.currencyCode }}">{{ ac.baseAmount|number_format(2, '.', '') }}</cbc:BaseAmount>
    </cac:AllowanceCharge>
    {% endfor %}

    {% for taxCode, group in totals.taxGroups %}
    <cac:TaxTotal>
        <cbc:TaxAmount currencyID="{{ doc.currencyCode }}">{{ group.amount|number_format(2, '.', '') }}</cbc:TaxAmount>
        {% for sub in group.subtotals %}
        <cac:TaxSubtotal>
            <cbc:TaxableAmount currencyID="{{ doc.currencyCode }}">{{ sub.base|number_format(2, '.', '') }}</cbc:TaxableAmount>
            <cbc:TaxAmount currencyID="{{ doc.currencyCode }}">{{ sub.amount|number_format(2, '.', '') }}</cbc:TaxAmount>
            <cac:TaxCategory>
                <cbc:Percent>{{ sub.percent|number_format(2, '.', '') }}</cbc:Percent>
                <cac:TaxScheme>
                    <cbc:ID>{{ sub.code }}</cbc:ID>
                    <cbc:Name>{{ sub.name }}</cbc:Name>
                </cac:TaxScheme>
            </cac:TaxCategory>
        </cac:TaxSubtotal>
        {% endfor %}
    </cac:TaxTotal>
    {% endfor %}

    <cac:LegalMonetaryTotal>
        <cbc:LineExtensionAmount currencyID="{{ doc.currencyCode }}">{{ totals.lineExtensionAmount|number_format(2, '.', '') }}</cbc:LineExtensionAmount>
        <cbc:TaxExclusiveAmount currencyID="{{ doc.currencyCode }}">{{ totals.taxExclusiveAmount|number_format(2, '.', '') }}</cbc:TaxExclusiveAmount>
        <cbc:TaxInclusiveAmount currencyID="{{ doc.currencyCode }}">{{ totals.taxInclusiveAmount|number_format(2, '.', '') }}</cbc:TaxInclusiveAmount>
        {% if totals.allowanceTotalAmount > 0 %}<cbc:AllowanceTotalAmount currencyID="{{ doc.currencyCode }}">{{ totals.allowanceTotalAmount|number_format(2, '.', '') }}</cbc:AllowanceTotalAmount>{% endif %}
        {% if totals.chargeTotalAmount > 0 %}<cbc:ChargeTotalAmount currencyID="{{ doc.currencyCode }}">{{ totals.chargeTotalAmount|number_format(2, '.', '') }}</cbc:ChargeTotalAmount>{% endif %}
        {% if totals.prepaidAmount > 0 %}<cbc:PrepaidAmount currencyID="{{ doc.currencyCode }}">{{ totals.prepaidAmount|number_format(2, '.', '') }}</cbc:PrepaidAmount>{% endif %}
        <cbc:PayableAmount currencyID="{{ doc.currencyCode }}">{{ totals.payableAmount|number_format(2, '.', '') }}</cbc:PayableAmount>
    </cac:LegalMonetaryTotal>

    {% for item in doc.items %}
    <cac:CreditNoteLine>
        <cbc:ID>{{ loop.index }}</cbc:ID>
        {% if item.note %}<cbc:Note>{{ item.note }}</cbc:Note>{% endif %}
        <cbc:CreditedQuantity unitCode="{{ item.unitCode }}">{{ item.cantidad|number_format(2, '.', '') }}</cbc:CreditedQuantity>
        <cbc:LineExtensionAmount currencyID="{{ doc.currencyCode }}">{{ (item.cantidad * item.precio)|number_format(2, '.', '') }}</cbc:LineExtensionAmount>

        {% for ac in item.allowanceCharges %}
        <cac:AllowanceCharge>
            <cbc:ID>{{ ac.id }}</cbc:ID>
            <cbc:ChargeIndicator>{{ ac.isCharge ? 'true' : 'false' }}</cbc:ChargeIndicator>
            <cbc:Amount currencyID="{{ doc.currencyCode }}">{{ ac.amount|number_format(2, '.', '') }}</cbc:Amount>
            <cbc:BaseAmount currencyID="{{ doc.currencyCode }}">{{ ac.baseAmount|number_format(2, '.', '') }}</cbc:BaseAmount>
        </cac:AllowanceCharge>
        {% endfor %}

        {% for tax in item.taxes %}
        <cac:TaxTotal>
            <cbc:TaxAmount currencyID="{{ doc.currencyCode }}">{{ tax.amount|number_format(2, '.', '') }}</cbc:TaxAmount>
            <cac:TaxSubtotal>
                <cbc:TaxableAmount currencyID="{{ doc.currencyCode }}">{{ tax.base|number_format(2, '.', '') }}</cbc:TaxableAmount>
                <cbc:TaxAmount currencyID="{{ doc.currencyCode }}">{{ tax.amount|number_format(2, '.', '') }}</cbc:TaxAmount>
                <cac:TaxCategory>
                    <cbc:Percent>{{ tax.percent|number_format(2, '.', '') }}</cbc:Percent>
                    <cac:TaxScheme>
                        <cbc:ID>{{ tax.code }}</cbc:ID>
                        <cbc:Name>{{ tax.name }}</cbc:Name>
                    </cac:TaxScheme>
                </cac:TaxCategory>
            </cac:TaxSubtotal>
        </cac:TaxTotal>
        {% endfor %}

        <cac:Item>
            <cbc:Description>{{ item.descripcion }}</cbc:Description>
            <cac:StandardItemIdentification>
                <cbc:ID schemeID="{{ item.codeScheme }}" schemeAgencyID="10">{{ item.code ?: ('999' ~ loop.index) }}</cbc:ID>
            </cac:StandardItemIdentification>
            {% if item.brandName %}<cbc:BrandName>{{ item.brandName }}</cbc:BrandName>{% endif %}
            {% if item.modelName %}<cbc:ModelName>{{ item.modelName }}</cbc:ModelName>{% endif %}
        </cac:Item>
        <cac:Price>
            <cbc:PriceAmount currencyID="{{ doc.currencyCode }}">{{ item.precio|number_format(2, '.', '') }}</cbc:PriceAmount>
            <cbc:BaseQuantity unitCode="{{ item.unitCode }}">{{ item.cantidad|number_format(2, '.', '') }}</cbc:BaseQuantity>
        </cac:Price>
    </cac:CreditNoteLine>
    {% endfor %}
</CreditNote>
