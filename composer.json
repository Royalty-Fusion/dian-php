{
    "name": "royaltyfusion/dian-php",
    "description": "SDK Open Source en PHP para Facturación Electrónica de la DIAN (Colombia) - UBL 2.1 Anexo Técnico V1.9",
    "type": "library",
    "license": "MIT",
    "keywords": ["dian", "colombia", "facturacion-electronica", "ubl", "ubl-2.1", "xades", "sdk"],
    "authors": [
        {
            "name": "Daniel Muñoz",
            "email": "dmunoz@royaltyfusion.com",
            "homepage": "https://royaltifusion.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-dom": "*",
        "ext-libxml": "*",
        "ext-openssl": "*",
        "ext-zip": "*",
        "ext-json": "*",
        "robrichards/xmlseclibs": "^3.1",
        "symfony/http-client": "^6.0 || ^7.0",
        "twig/twig": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0",
        "phpstan/phpstan": "^1.12",
        "squizlabs/php_codesniffer": "^3.10",
        "symfony/console": "^6.0 || ^7.0",
        "symfony/config": "^6.0 || ^7.0",
        "symfony/dependency-injection": "^6.0 || ^7.0",
        "symfony/http-kernel": "^6.0 || ^7.0",
        "symfony/yaml": "^6.0 || ^7.0",
        "symfony/var-dumper": "^6.0 || ^7.0"
    },
    "suggest": {
        "symfony/framework-bundle": "Required to wire the bundle inside a Symfony project (>= 6.0)",
        "dompdf/dompdf": "Renders the HTML representación gráfica into PDF",
        "mpdf/mpdf": "Alternative HTML-to-PDF engine"
    },
    "autoload": {
        "psr-4": {
            "RoyaltyFusion\\DianPhp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RoyaltyFusion\\DianPhp\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite=unit",
        "test:integration": "phpunit --testsuite=integration",
        "analyse": "phpstan analyse --memory-limit=512M",
        "cs": "phpcs",
        "cs:fix": "phpcbf"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
